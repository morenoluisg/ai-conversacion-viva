# Modo de voz: local o deepgram. La selección también aparece en el panel.
DEFAULT_STT=local
# Faster-Whisper: se descarga una vez al preparar/iniciar el modo local.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_CHUNK_SECONDS=6
AUDIO_OVERLAP_SECONDS=1
# Si usas Deepgram, crea una clave y colócala aquí, nunca en el navegador.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Conceptos: rules para empezar, ollama para extracción semántica.
CONCEPT_PROVIDER=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=8

# Inferencia de categorías y conceptos. Clave solo en el servidor.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Despliegue: escucha y dominios (sin cambiar las claves en los clientes).
BIND_HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Identidad inicial. El panel puede cambiarla por sesión hasta reiniciar el servidor.
# Usa comillas para los colores y para textos con espacios o el carácter #.
APP_NAME="Conversación viva"
APP_ORGANIZATION="MinAmbiente · Laboratorio de ideas"
APP_DESCRIPTION="Una conversación que construimos juntos"
APP_CENTER_TOP="DIÁLOGO"
APP_CENTER_BOTTOM="AMBIENTAL"
APP_PANEL_HEADING="Ahora conversamos sobre"
APP_ACCENT_COLOR="#287a38"
