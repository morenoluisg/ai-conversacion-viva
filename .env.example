# Modo de voz: local o deepgram. La selección también aparece en el panel.
DEFAULT_STT=local
# Faster-Whisper: se descarga una vez al preparar/iniciar el modo local.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
AUDIO_CHUNK_SECONDS=6
AUDIO_OVERLAP_SECONDS=1
# Si usas Deepgram, crea una clave y colócala aquí, nunca en el navegador.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Conceptos: rules para empezar, ollama para extracción semántica.
CONCEPT_PROVIDER=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=8
